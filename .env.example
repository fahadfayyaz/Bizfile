PORT=3000

# Optional. Defaults are the same Chrome path/profile used by the current automation.
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
CHROME_USER_DATA_DIR=C:/Users/Fahad Fayyaz/AppData/Local/Google/Chrome/User Data/Profile 2
ACCEPT_LANGUAGE=en-US,en;q=0.9

# Optional proxy, if needed.
PROXY_URL=

# Optional. When a visible challenge appears in headed Chrome, wait this long
# so a human can resolve it manually before the scraper rechecks the page.
MANUAL_CHALLENGE_WAIT_MS=0

# Optional scraper tuning.
BIZFILE_URL=https://www.bizfile.gov.sg/
EXTRACT_PAGE_SIZE=10
DISABLE_SEARCH_API=false
DISABLE_EXTRACT_API=true
ENABLE_EXTRACT_API_FALLBACK=false
RATE_LIMIT_MAX_RETRIES=1
RATE_LIMIT_RETRY_DELAY_MS=30000
