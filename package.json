{
  "name": "bizfile-filings-service",
  "version": "1.0.0",
  "description": "Node.js/TypeScript service that returns BizFile (ACRA Singapore) filing extracts as structured JSON",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "sample": "tsx scripts/sample.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "playwright-core": "^1.49.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
